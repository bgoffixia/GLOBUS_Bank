modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/globus-bank: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/globus-bank"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/globus-bank run dev"
cwd = "./artifacts/globus-bank"
waitForPort = 24083
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "24083"
BASE_PATH = "/"

[[workflows.workflow]]
name = "artifacts/api-server: API Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "packager.installForLanguage"
args = ""

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "XegfDyZt7HqfW2Bb8Ghoy"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/mockup-sandbox run dev"
cwd = "./artifacts/mockup-sandbox"
waitForPort = 8081
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8081"
BASE_PATH = "/__mockup"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
GLOBUS_ADMIN_CLERK_IDS = "user_3Kh6wyO6bPqf1JcXaWPxo2CkOkd"
GLOBUS_ADMIN_EMAILS = "agbodave807@gmail.com,ceo@bg-offixia.digital"

[userenv.shared]
GLOBUS_SECURITY_EMAIL_FROM = "passwordreset@globus.website"

[userenv.production]
GLOBUS_ADMIN_EMAILS = "bg.offixia@gmail.com,ceo@bg-offixia.digital"

[objectStorage]
defaultBucketID = "replit-objstore-4961e80f-6330-48d1-850b-c59d962859e1"
