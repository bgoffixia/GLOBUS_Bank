# External Clerk application credentials. Configure them separately in the
# development Secrets and Production app secrets; never store values here.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PROXY_URL=

# Comma-separated, server-only admin identities. Empty means no admin access.
DUTSTAR_ADMIN_CLERK_IDS=

# Configure SUPABASE_DATABASE_URL separately in Replit development Secrets and
# Publishing > Production app secrets. Never commit its value.
# PORT and BASE_PATH are supplied by the managed workspace.

# For the single-service Railway Docker deployment:
# DUTSTAR_APP_ORIGIN=https://your-public-domain.example
# Railway supplies PORT. VITE_CLERK_PUBLISHABLE_KEY is a Docker build variable.
