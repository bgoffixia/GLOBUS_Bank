# External Clerk application credentials. Configure them separately in
# development and production secrets; never store values here.
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PUBLISHABLE_KEY=
# VITE_CLERK_PROXY_URL=

# Server-only admin allowlists. Empty means no admin access.
DUTSTAR_ADMIN_CLERK_IDS=
DUTSTAR_ADMIN_EMAILS=

# Public application origin for server-generated links.
DUTSTAR_APP_ORIGIN=https://www.bank.dutstar.online

# Legacy GLOBUS_* aliases remain accepted during migration.
# Configure SUPABASE_DATABASE_URL only if direct PostgreSQL access is required.
# PORT and BASE_PATH are supplied by the managed workspace.
