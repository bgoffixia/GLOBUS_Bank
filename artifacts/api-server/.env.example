# Server-only email delivery configuration for Private Vault PIN reset links.
# The mailbox domain must be verified in the Resend account used by RESEND_API_KEY.
# DUTSTAR_APP_ORIGIN is the public customer-facing application origin.
DUTSTAR_APP_ORIGIN=https://www.bank.dutstar.online

# Server-only admin allowlists. Keep Clerk IDs and emails in secret configuration.
DUTSTAR_ADMIN_CLERK_IDS=
DUTSTAR_ADMIN_EMAILS=

# Security email sender mailbox. Keep the existing verified mailbox until a
# DUTSTAR sending domain has been verified with the email provider.
DUTSTAR_SECURITY_EMAIL_FROM=security@globus.website
DUTSTAR_VAULT_PIN_RESET_EMAIL_FROM=security@globus.website

# Legacy aliases remain supported during migration:
# GLOBUS_APP_ORIGIN=
# GLOBUS_ADMIN_CLERK_IDS=
# GLOBUS_ADMIN_EMAILS=
# GLOBUS_SECURITY_EMAIL_FROM=
# GLOBUS_VAULT_PIN_RESET_EMAIL_FROM=

# Required by the API server. Store the value in Cloudflare secret configuration,
# never in source control.
# RESEND_API_KEY=
