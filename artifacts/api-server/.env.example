# Server-only email delivery configuration for Private Vault PIN reset links.
# The mailbox domain must be verified in the Resend account used by RESEND_API_KEY.
# Preferred sender setting; must be a mailbox address only (no display name).
GLOBUS_VAULT_PIN_RESET_EMAIL_FROM=security@globus.website

# Required by the API server. Keep the value in Railway Variables, never in source control.
# RESEND_API_KEY=

# Backward-compatible fallback used only when the dedicated sender setting is absent.
# GLOBUS_SECURITY_EMAIL_FROM=security@globus.website

# Transfer notification sender. The domain must be verified in Resend.
# On Cloudflare Workers, enable Node.js compatibility (compatibility_date 2026-08-04 or later) so node:net and node:tls can use outbound TCP sockets.
DUTSTAR_TRANSFER_ALERT_EMAIL_FROM=paymentnotification@infomail.click
RESEND_SMTP_HOST=smtp.resend.com
RESEND_SMTP_PORT=587
RESEND_SMTP_USERNAME=resend

# Required server-side Resend API key. Configure as a secret in the deployment host.
# RESEND_API_KEY=
