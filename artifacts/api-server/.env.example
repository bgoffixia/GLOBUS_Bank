# Server-only email delivery configuration for Private Vault PIN reset links.
# The mailbox domain must be verified in the Resend account used by RESEND_API_KEY.
DUTSTAR_APP_ORIGIN=https://www.bank.dutstar.online\nDUTSTAR_ADMIN_CLERK_IDS=\nDUTSTAR_ADMIN_EMAILS=\nDUTSTAR_SECURITY_EMAIL_FROM=security@globus.website\n\n# Preferred sender setting; must be a mailbox address only (no display name).
DUTSTAR_VAULT_PIN_RESET_EMAIL_FROM=security@globus.website

# Required by the API server. Keep the value in Railway Variables, never in source control.
# RESEND_API_KEY=

# Backward-compatible fallback used only when the dedicated sender setting is absent.
# DUTSTAR_SECURITY_EMAIL_FROM=security@globus.website
