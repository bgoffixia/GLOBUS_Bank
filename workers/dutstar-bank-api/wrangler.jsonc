{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dutstar-bank-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "../../artifacts/globus-bank/dist/public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"],
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "hyperdrive": [
    {
      "binding": "DB",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],
  "vars": {
    "CLERK_JWKS_URL": "REPLACE_WITH_PRODUCTION_CLERK_JWKS_URL"
  }
}
